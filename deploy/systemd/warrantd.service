# 노드 에이전트. sshd 보다 먼저 떠서 PAM 소켓을 열어 둬야 한다 — 늦으면 그 사이 세션은 태그 없이 시작된다.
# BPF 는 warrantd 가 직접 올린다(loader). 맵과 링크는 bpffs 에 pin 되어 재시작 · 크래시에도 남는다.
# Type=notify: warrantd 가 소켓을 연 뒤 READY=1 을 보내야 started 가 되고, 그다음에 sshd 가 뜬다.
#
# ssh.socket 에는 순서를 걸지 말 것. ssh.socket 은 sockets.target 의 일부라 basic.target 보다 먼저인데,
# 이 서비스는 기본 의존성으로 basic.target 뒤다 — Before=ssh.socket 을 넣으면 순환이 생기고 systemd 가
# 아무 작업이나 하나 버린다. 2026-10-24 Lima VM 에서 ssh.socket 이 버려져 sshd 가 안 떴다.
# 소켓 활성화에서는 접속이 와도 ssh.service 가 뜰 때까지 연결이 소켓에 대기하므로 ssh.service 앞이면 충분하다.
[Unit]
Description=Session Warrant node agent
After=network-online.target
Wants=network-online.target
Before=ssh.service sshd.service

[Service]
Type=notify
EnvironmentFile=-/etc/default/warrantd
ExecStart=/usr/local/sbin/warrantd -pin-dir /sys/fs/bpf/warrant -bpf-obj /usr/lib/warrant/warrant.bpf.o -pam-socket /run/warrantd/pam.sock $WARRANTD_ARGS
Restart=always
RestartSec=1s
TimeoutStartSec=30s

# PAM 소켓 자리. 0700 — root 인 sshd 만 들어온다. 감사 큐 영속(bbolt) 자리는 StateDirectory.
RuntimeDirectory=warrantd
RuntimeDirectoryMode=0700
StateDirectory=warrantd
StateDirectoryMode=0700

# PrivateTmp · ProtectHome 은 넣지 말 것. 정책의 경로를 (dev, ino) 로 바꾸는 게 warrantd 라서 세션과
# 같은 파일시스템을 봐야 한다 — 넣으면 /tmp · /home 규칙이 warrantd 전용 tmpfs 의 inode 로 컴파일된다(2026-11-03).
NoNewPrivileges=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
