{
  "realm": "warrant",
  "displayName": "Session Warrant",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "groups": [
    { "name": "warrant-requesters" },
    { "name": "warrant-approvers" },
    { "name": "warrant-auditors" }
  ],
  "clients": [
    {
      "clientId": "warrant-server",
      "name": "Session Warrant console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-warrant-server-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/login/oauth2/code/keycloak",
        "http://localhost:8080/login/oauth2/code/keycloak",
        "http://127.0.0.1:5180/login/oauth2/code/keycloak"
      ],
      "webOrigins": ["http://localhost:5173", "http://127.0.0.1:5180"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://127.0.0.1:5180/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
