{
  "uid": "warrant-ssh",
  "title": "SSH 접속 현황",
  "description": "조직 전체 SSH 접속 — 영장 세션과 무영장 세션. 감사 모드 — 막지 않고 기록만 한다.",
  "tags": [
    "session-warrant",
    "audit"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "SSH 접속",
      "description": "선택한 기간에 열린 SSH 세션 전부 — 영장 세션 + 무영장 세션.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warrant-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) FROM ssh_session WHERE $__timeFilter(observed_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "영장 세션",
      "description": "영장이 맞아 커널 태그가 붙은 세션.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warrant-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) FROM ssh_session WHERE $__timeFilter(observed_at) AND warranted"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "무영장 세션",
      "description": "영장 없이 열린 세션. 사유는 「무영장 세션」 대시보드.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warrant-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) FROM ssh_session WHERE $__timeFilter(observed_at) AND NOT warranted"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "영장 비율",
      "description": "SSH 접속 중 영장 세션의 비율. 접속이 없으면 비운다.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warrant-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE warranted) / nullif(count(*), 0) FROM ssh_session WHERE $__timeFilter(observed_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "SSH 접속 · 영장 여부별",
      "description": "구간마다 열린 세션 수.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "interval": "10m",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warrant-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(observed_at, $__interval, 0),\n       CASE WHEN warranted THEN 'warranted' ELSE 'unwarranted' END AS metric,\n       count(*) AS value\nFROM ssh_session\nWHERE $__timeFilter(observed_at)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 100,
            "lineWidth": 0,
            "barAlignment": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "axisLabel": "세션 수"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "warranted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              },
              {
                "id": "displayName",
                "value": "영장 세션"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "unwarranted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#eb6834"
                }
              },
              {
                "id": "displayName",
                "value": "무영장 세션"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "노드별",
      "description": "노드마다 열린 세션 수. 무영장이 많은 노드가 게이트웨이를 우회하는 길이다.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warrant-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT n.hostname AS \"노드\",\n       count(*) AS \"접속\",\n       count(*) FILTER (WHERE s.warranted) AS \"영장\",\n       count(*) FILTER (WHERE NOT s.warranted) AS \"무영장\",\n       count(DISTINCT s.login_account) AS \"계정\",\n       count(DISTINCT s.source_address) AS \"출발지\",\n       max(s.observed_at) AS \"마지막 접속\"\nFROM ssh_session s\nJOIN node n ON n.id = s.node_id\nWHERE $__timeFilter(s.observed_at)\nGROUP BY n.hostname\nORDER BY 4 DESC, 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "마지막 접속"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm:ss"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "계정별",
      "description": "로그인 계정마다. 영장 없이 들어온 계정이 위로 온다.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warrant-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT coalesce(s.login_account, '—') AS \"계정\",\n       count(*) AS \"접속\",\n       count(*) FILTER (WHERE s.warranted) AS \"영장\",\n       count(*) FILTER (WHERE NOT s.warranted) AS \"무영장\",\n       count(DISTINCT s.node_id) AS \"노드\",\n       count(DISTINCT s.ssh_key_fingerprint) AS \"키\",\n       count(DISTINCT s.source_address) AS \"출발지\"\nFROM ssh_session s\nWHERE $__timeFilter(s.observed_at)\nGROUP BY 1\nORDER BY 4 DESC, 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "최근 접속",
      "description": "새 것부터. 영장 세션이면 영장 번호와 모드, 무영장이면 사유.",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warrant-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT s.observed_at AS \"시각\",\n       n.hostname AS \"노드\",\n       s.login_account AS \"계정\",\n       coalesce(s.source_address, '—') AS \"출발지\",\n       CASE WHEN s.warranted THEN '#' || s.warrant_id ELSE '—' END AS \"영장\",\n       coalesce(s.mode, s.reason) AS \"모드 · 사유\",\n       coalesce(s.ssh_key_fingerprint, '키 없음') AS \"키 지문\",\n       s.cgroup_id AS \"cgroup\"\nFROM ssh_session s\nJOIN node n ON n.id = s.node_id\nWHERE $__timeFilter(s.observed_at)\nORDER BY s.observed_at DESC\nLIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "시각"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm:ss"
              },
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cgroup"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    }
  ]
}
